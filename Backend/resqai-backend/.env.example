# ResQAI Environment Configuration

# Google Gemini API Key (Preferred)
# Keep real credentials only in .env, never in frontend VITE_* variables.
GEMINI_API_KEY=
# Alternative alias:
# GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (Secondary fallback)
GROQ_API_KEY=

# LLM Model Selection
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile

# Orchestrator & Server Settings
PORT=8000
API_TIMEOUT_SECONDS=20.0
MAX_RETRIES=1
